# Build context exclusions for Docker
# Keeps the image lean and the build fast

# Dependencies (reinstalled during build)
node_modules

# Next.js build output (rebuilt during image build)
.next

# Local environment / secrets
.env
.env.local
.env.development
.env.production

# Local SQLite database files
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# Version control
.git
.gitignore

# Editor / OS
.DS_Store
*.swp
.idea
.vscode

# Logs
*.log
npm-debug.log*

# Test artifacts
coverage
.nyc_output

# Docs
README.md
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
LICENSE

# GitHub-specific
.github

# Miscellaneous
*.md
